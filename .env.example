# —— Astro build (site içeriği okuma) ——
# Sanity yapılandırılınca site build'de buradan okur. Boşsa DEV'de yerel
# içerik dosyalarına düşer; CANLI=1 derlemesinde bunlar ZORUNLUdur.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# —— Yayın derlemesi işareti ——
# CANLI=1 iken: Sanity zorunlu, seed/yer tutucu tespit edilirse build durur.
# CANLI=1

# —— Teklif formu (Netlify Function) ——
# Bu değerler Netlify panelinde (Site settings → Environment variables) girilir.
RESEND_API_KEY=
TEKLIF_FROM=Pekparts <bildirim@pekparts.com>
TALEP_EPOSTA=            # yedek; asıl adres Sanity siteAyarlari.talepEpostasi
SANITY_WRITE_TOKEN=      # Sanity "Editor" yetkili token (talep yazımı için)
