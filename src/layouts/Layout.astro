---
import "@/styles/global.css";

// Fontlar YEREL yüklenir (CDN yok — Şartname §3/§10, kural). @fontsource
// paketleri font dosyalarını build'e gömer.
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";

import { dilBul, ceviriYap, yolunGerisi, yon } from "@/i18n/utils";
import { aktifDiller } from "@/i18n/ui";
import { marka } from "@/site";
import { getAyarlar } from "@/lib/ayarlar";
import TopBar from "@/components/TopBar.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";

interface Props {
  baslik?: string;
  aciklama?: string;
  ogGorsel?: string; // WhatsApp/OG önizleme görseli (ürün sayfasında ilk görsel)
  ogTip?: string; // "website" | "product" vb.
}

const aktifDil = dilBul(Astro.url);
const t = ceviriYap(aktifDil);
const dir = yon(aktifDil);
const ayarlar = await getAyarlar();

const { baslik, aciklama, ogGorsel, ogTip = "website" } = Astro.props;
const sayfaBaslik = baslik ? `${baslik} · ${marka.ad}` : `${marka.ad} — ${marka.unvan}`;
const sayfaAciklama = aciklama ?? t("site.aciklama");
// OG görseli: ürün sayfasında ilk görsel (Sanity CDN); diğer sayfalarda site
// varsayılanı (logolu /og-pekparts.png). Mutlak URL — WhatsApp önizlemesi için.
const ogMutlak = new URL(ogGorsel ?? "/og-pekparts.png", Astro.site).href;

// hreflang: her dil için, dil öneki soyulmuş yol üzerinden mutlak URL (sonda /).
const kalanYol = yolunGerisi(Astro.url); // öneksiz yol
const altUrl = (d: string) =>
  new URL(kalanYol ? `/${d}/${kalanYol}/` : `/${d}/`, Astro.site).href;
const kanonik = altUrl(aktifDil);

// Yayın anahtarı: PUBLIC_SITE_INDEXABLE=true olana kadar noindex (§11/§7 yayın).
const indexlenebilir =
  (import.meta.env.PUBLIC_SITE_INDEXABLE ?? process.env.PUBLIC_SITE_INDEXABLE) === "true";
---

<!doctype html>
<html lang={aktifDil} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{sayfaBaslik}</title>
    <meta name="description" content={sayfaAciklama} />
    <link rel="canonical" href={kanonik} />

    {/* Yayına kadar indekslenmeyi engelle (§7 yayın anahtarı). */}
    {!indexlenebilir && <meta name="robots" content="noindex, nofollow" />}

    <!-- hreflang — Şartname §7/§11. Her dil + x-default (varsayılan dil: en). -->
    {aktifDiller.map((d) => <link rel="alternate" hreflang={d} href={altUrl(d)} />)}
    <link rel="alternate" hreflang="x-default" href={altUrl("en")} />

    <!-- Open Graph — WhatsApp'ta link önizlemesi için (§11). -->
    <meta property="og:type" content={ogTip} />
    <meta property="og:site_name" content={marka.ad} />
    <meta property="og:title" content={sayfaBaslik} />
    <meta property="og:description" content={sayfaAciklama} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:locale" content={aktifDil} />
    <meta property="og:image" content={ogMutlak} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    
    {import.meta.env.PUBLIC_SITE_INDEXABLE !== "true" && (
    <meta name="robots" content="noindex, nofollow" />
    )}

<!-- Google tag (gtag.js) -->
<script
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-N2HK39G5MZ"
></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  gtag("config", "G-N2HK39G5MZ");
</script>

  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#ana-icerik" class="skip-link">{t("a11y.anaIcerige")}</a>

    <TopBar aktifDil={aktifDil} url={Astro.url} ayarlar={ayarlar} />
    <Header aktifDil={aktifDil} />

    <main id="ana-icerik" class="flex-1">
      <slot />
    </main>

    <Footer aktifDil={aktifDil} ayarlar={ayarlar} />
    <WhatsAppButton aktifDil={aktifDil} ayarlar={ayarlar} />
  </body>
</html>

<style>
  /* "Ana içeriğe geç" — normalde gizli, klavye odağında görünür. */
  .skip-link {
    position: absolute;
    inset-inline-start: 0.5rem;
    top: -3rem;
    z-index: 50;
    background: var(--color-vurgu);
    color: var(--color-kagit);
    padding: 0.5rem 0.75rem;
    border-radius: 0 0 4px 4px;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 0;
  }
</style>
