---
import Layout from "@/layouts/Layout.astro";
import Rozet from "@/components/Rozet.astro";
import TeklifForm from "@/components/TeklifForm.astro";
import { ceviriYap, dilliYol, type Dil } from "@/i18n/utils";
import { diller } from "@/i18n/ui";
import { tumUrunler, yerelDeger, markaAdi } from "@/lib/katalog";
import { whatsappLink } from "@/site";
import { getAyarlar } from "@/lib/ayarlar";
import WhatsAppSor from "@/components/WhatsAppSor.astro";

export async function getStaticPaths() {
  const urunler = await tumUrunler();
  return diller.flatMap((lang) =>
    urunler.map((u) => ({ params: { lang, parcaNo: u.slug } })),
  );
}

const aktifDil = Astro.params.lang as Dil;
const { parcaNo } = Astro.params;
const t = ceviriYap(aktifDil);

const urunler = await tumUrunler();
const urun = urunler.find((u) => u.slug === parcaNo);
if (!urun) return Astro.rewrite("/404");

const ad = yerelDeger(urun.ad, aktifDil);
const aciklama = yerelDeger(urun.aciklama, aktifDil);
const kategoriAd = yerelDeger(urun.kategoriAd, aktifDil);
const markaGoster = markaAdi(urun.markaSlug, urun.markaAd, aktifDil);

// WhatsApp sipariş/sor — parça bilgisi ön-doldurulmuş (e-posta yerine WhatsApp'ı öne çıkar).
const ayarlar = await getAyarlar();
const waSiparis = whatsappLink(
  ayarlar.whatsapp,
  t("urun.whatsappMesaj", { marka: markaGoster, no: urun.parcaNo, ad }),
);

// Benzersiz meta açıklama: açıklama varsa onu; yoksa parça bilgisinden üret
// (şablon tekrarı yasak, §11). Parça no her ürüne benzersizlik verir.
const metaAciklama =
  aciklama ||
  [
    `${ad} — ${urun.markaAd}, ${kategoriAd}.`,
    `${t("urun.parcaNo")}: ${urun.parcaNo}.`,
    urun.motorlar.length
      ? `${t("urun.uyumluMotorlar")}: ${urun.motorlar.slice(0, 4).map((m) => m.ad).join(", ")}.`
      : "",
  ]
    .filter(Boolean)
    .join(" ");

// Görseller: adaptörde çözülmüş URL'ler; yoksa yer tutucu.
const gorseller = urun.gorseller
  .filter((g) => g.url)
  .map((g) => ({
    yol: g.url!,
    alt: g.alt ? yerelDeger(g.alt, aktifDil) : t("urun.gorselAcilim", { ad, no: urun.parcaNo }),
  }));

// schema.org Product — fiyat GÖSTERİLMİYOR (§5). `offers` bloğu tümüyle
// kaldırıldı: schema.org'da `availability` yalnızca `offers` altında geçerli ve
// fiyatsız Offer bırakmak istemiyoruz. Stok bilgisi sayfada rozet olarak var.
const kanonik = new URL(dilliYol(aktifDil, `urun/${urun.slug}`), Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: ad,
  sku: urun.parcaNo,
  mpn: urun.parcaNo,
  brand: { "@type": "Brand", name: urun.markaAd },
  category: kategoriAd,
  url: kanonik,
  ...(gorseller.length
    ? { image: gorseller.map((g) => new URL(g.yol, Astro.site).href) }
    : {}),
};
---

<Layout
  baslik={`${urun.parcaNo} · ${ad}`}
  aciklama={metaAciklama}
  ogGorsel={gorseller[0]?.yol}
  ogTip="product"
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <!-- Kırıntı -->
    <nav aria-label="breadcrumb" class="mb-6 text-sm text-murekkep/60">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={dilliYol(aktifDil, "urunler")} class="hover:underline">{t("liste.tumUrunler")}</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={dilliYol(aktifDil, `urunler/${urun.kategoriSlug}`)} class="hover:underline">{kategoriAd}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="parca-no text-murekkep/80">{urun.parcaNo}</li>
      </ol>
    </nav>

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Galeri -->
      <div>
        {
          gorseller.length > 0 ? (
            <div class="space-y-3" data-galeri>
              <div class="aspect-4/3 overflow-hidden rounded border border-kenarlik bg-yuzey">
                <img
                  data-galeri-ana
                  src={gorseller[0].yol}
                  alt={gorseller[0].alt}
                  class="h-full w-full object-cover"
                />
              </div>
              {gorseller.length > 1 && (
                <ul class="grid grid-cols-4 gap-2">
                  {gorseller.map((g, i) => (
                    <li>
                      <button
                        type="button"
                        data-galeri-kucuk
                        data-yol={g.yol}
                        data-alt={g.alt}
                        aria-label={g.alt}
                        aria-current={i === 0 ? "true" : "false"}
                        class="block aspect-square w-full overflow-hidden rounded border border-kenarlik bg-yuzey aria-[current=true]:border-vurgu aria-[current=true]:ring-2 aria-[current=true]:ring-vurgu/40"
                      >
                        <img src={g.yol} alt="" loading="lazy" class="h-full w-full object-cover" />
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ) : (
            <div class="flex aspect-4/3 flex-col items-center justify-center gap-2 rounded border border-kenarlik bg-yuzey text-murekkep/40">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v10M7 12h10" />
              </svg>
              <span class="text-sm">{t("urun.gorselYok")}</span>
            </div>
          )
        }
      </div>

      <!-- Bilgi -->
      <div>
        <p class="text-sm font-medium text-murekkep/60">{markaGoster}</p>
        <p class="parca-no mt-0.5 text-lg font-semibold text-bakir-koyu">{urun.parcaNo}</p>
        <h1 class="mt-1 text-2xl font-bold tracking-tight">{ad}</h1>

        <div class="mt-3 flex flex-wrap gap-2">
          <Rozet deger={urun.stokDurumu} aktifDil={aktifDil} />
        </div>

        {aciklama && <p class="mt-4 text-murekkep/80">{aciklama}</p>}

        <!-- Teknik tablo -->
        <dl class="mt-6 divide-y divide-kenarlik border-y border-kenarlik text-sm">
          <div class="flex gap-4 py-2.5">
            <dt class="w-32 shrink-0 text-murekkep/60">{t("urun.marka")}</dt>
            <dd>
              <a href={dilliYol(aktifDil, `marka/${urun.markaSlug}`)} class="hover:underline">{markaGoster}</a>
            </dd>
          </div>
          <div class="flex gap-4 py-2.5">
            <dt class="w-32 shrink-0 text-murekkep/60">{t("urun.kategori")}</dt>
            <dd>
              <a href={dilliYol(aktifDil, `urunler/${urun.kategoriSlug}`)} class="hover:underline">{kategoriAd}</a>
            </dd>
          </div>
          {
            urun.muadilNo.length > 0 && (
              <div class="flex gap-4 py-2.5">
                <dt class="w-32 shrink-0 text-murekkep/60">{t("urun.muadilNo")}</dt>
                <dd class="parca-no">{urun.muadilNo.join(" · ")}</dd>
              </div>
            )
          }
        </dl>

        <!-- Uyumlu motorlar: tıklanabilir → /marka/[marka]/[motor] -->
        {
          urun.motorlar.length > 0 && (
            <div class="mt-6">
              <h2 class="mb-2 text-sm font-semibold">{t("urun.uyumluMotorlar")}</h2>
              <ul class="flex flex-wrap gap-2">
                {urun.motorlar.map((m) => (
                  <li>
                    <a
                      href={dilliYol(aktifDil, `marka/${urun.markaSlug}/${m.slug}`)}
                      class="parca-no inline-block rounded border border-kenarlik bg-yuzey px-2.5 py-1 text-xs text-murekkep no-underline hover:border-vurgu hover:text-vurgu"
                    >
                      {m.ad}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={waSiparis}
            rel="noopener"
            class="inline-flex items-center gap-2 rounded bg-vurgu px-5 py-2.5 text-sm font-medium text-kagit no-underline hover:bg-vurgu/90"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.86 9.86 0 0 0 4.73 1.2h.01c5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2zm5.8 14.16c-.24.68-1.4 1.3-1.94 1.34-.5.05-1.12.07-1.8-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.98 0-1.42.74-2.12 1-2.4.26-.29.57-.36.76-.36l.55.01c.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.12.57.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.42.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.39-.24.65-.14.26.09 1.67.79 1.96.93.29.14.48.21.55.33.07.12.07.69-.17 1.37z"
              ></path>
            </svg>
            {t("urun.whatsappSiparis")}
          </a>
          <a
            href="#teklif"
            class="inline-flex items-center rounded border border-kenarlik px-5 py-2.5 text-sm font-medium text-murekkep no-underline hover:border-vurgu hover:text-vurgu"
          >
            {t("urun.fiyatSor")}
          </a>
        </div>
      </div>
    </div>

    <!-- Teklif formu -->
    <div class="mt-10 max-w-2xl">
      <TeklifForm aktifDil={aktifDil} parcaNo={urun.parcaNo} urunAd={ad} />
    </div>
  </div>

  <!-- "Doğru parçayı bulamadınız mı? WhatsApp'tan sorun" -->
  <WhatsAppSor aktifDil={aktifDil} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script>
    import "@/scripts/galeri.ts";
  </script>
</Layout>
