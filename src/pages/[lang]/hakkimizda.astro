---
import Layout from "@/layouts/Layout.astro";
import IcerikSayfa from "@/components/IcerikSayfa.astro";
import { ceviriYap, type Dil } from "@/i18n/utils";
import { diller } from "@/i18n/ui";
import { sanitySayfa } from "@/lib/sanity";

export function getStaticPaths() {
  return diller.map((lang) => ({ params: { lang } }));
}
const aktifDil = Astro.params.lang as Dil;
const t = ceviriYap(aktifDil);
const sayfa = await sanitySayfa("hakkimizda"); // CMS'ten; yoksa null → yer tutucu
---

<Layout baslik={t("nav.hakkimizda")}>
  <IcerikSayfa aktifDil={aktifDil} varsayilanBaslik={t("nav.hakkimizda")} sayfa={sayfa} />
</Layout>
