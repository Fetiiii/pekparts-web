---
import Layout from "@/layouts/Layout.astro";
import SearchBox from "@/components/SearchBox.astro";
import { ceviriYap } from "@/i18n/utils";
import { varsayilanDil } from "@/i18n/ui";

// Statik 404 — dil öneki yok, varsayılan dil (tr) kullanılır. Netlify bunu
// bulunamayan yollarda sunar. Boş-arama mantığı: kullanıcıyı kaybetme,
// aramaya ve WhatsApp'a yönlendir (Layout sabit WhatsApp butonu zaten var).
const dil = varsayilanDil;
const t = ceviriYap(dil);
const tEn = ceviriYap("en");
---

<Layout baslik={t("404.baslik")}>
  <section class="mx-auto max-w-2xl px-4 py-16 text-center">
    <p class="parca-no text-4xl font-bold text-bakir-koyu">404</p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight">{t("404.baslik")}</h1>
    <p class="mx-auto mt-3 max-w-md text-murekkep/75">{t("404.metin")}</p>
    <p class="mx-auto mt-1 max-w-md text-sm text-murekkep/55">{tEn("404.metin")}</p>

    <div class="mx-auto mt-8 max-w-md">
      <SearchBox aktifDil={dil} buyuk />
    </div>

    <p class="mt-6">
      <a href={`/${dil}/`} class="text-vurgu hover:underline">{t("404.anasayfa")}</a>
    </p>
  </section>
</Layout>
