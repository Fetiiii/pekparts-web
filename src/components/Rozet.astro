---
import { ceviriYap, type Dil } from "@/i18n/utils";

interface Props {
  deger: "stokta" | "siparise-bagli" | "tukendi";
  aktifDil: Dil;
}
const { deger, aktifDil } = Astro.props;
const t = ceviriYap(aktifDil);

// Stok rozeti. Ayırt edicilik renge değil metin + dolgu/ağırlığa dayanır
// (renk körlüğü / WCAG); her rozet her zaman metin etiketi taşır.
const stil: Record<string, string> = {
  stokta: "bg-vurgu text-kagit",
  "siparise-bagli": "border border-bakir text-bakir-koyu",
  tukendi: "border border-kenarlik text-murekkep/55",
};
const metin = t(`stok.${deger}`);
---

<span
  class:list={[
    "inline-flex items-center rounded px-2 py-0.5 text-xs font-medium whitespace-nowrap",
    stil[deger] ?? "border border-kenarlik text-murekkep/70",
  ]}>{metin}</span
>
